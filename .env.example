# Las variables NEXT_PUBLIC_ se exponen al navegador; nunca incluyas secretos.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
# Solo servidor Next.js. Desarrollo local HTTP explícito.
NEXOGUARD_HTTP_MODE=local
API_INTERNAL_URL=http://127.0.0.1:3001

# Producción: API_INTERNAL_URL=https://back:3001; NODE_EXTRA_CA_CERTS y
# NEXOGUARD_INTERNAL_TLS_CERT/KEY apuntan a montajes privados (ver README).
