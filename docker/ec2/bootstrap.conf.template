server {
  listen 8080 default_server;
  server_name _;
  location = /health/live { return 200 'ok'; }
  location / { return 444; }
}
server {
  listen 8080;
  server_name ${PUBLIC_HOST};
  location ^~ /.well-known/acme-challenge/ { root /var/www/acme; default_type text/plain; }
  location = /health/live { return 200 'ok'; }
  # No app, cookies, login or redirect to an unavailable TLS listener.
  location / { return 503 'HTTPS initialization pending'; }
}
