# Valores públicos de build: únicamente la ruta del mismo hostname.
NEXT_PUBLIC_API_URL=/api
NEXT_TELEMETRY_DISABLED=1
PORT=3000
# Solo runtime de Next; jamás NEXT_PUBLIC_API_INTERNAL_URL.
API_INTERNAL_URL=http://back.railway.internal:3001
# Gateway (servicio separado, mismo repositorio, docker/railway.gateway.json):
# PORT=8080
# PUBLIC_HOST=REEMPLAZAR.up.railway.app
# FRONT_HOST=front.railway.internal
# BACK_HOST=back.railway.internal
