server {
    listen ${PORT} default_server;
    listen [::]:${PORT} default_server;
    server_name _;
    resolver ${DNS_RESOLVER} valid=10s;
    resolver_timeout 3s;
    access_log off;
    location = /health/live { default_type application/json; return 200 '{"status":"ok"}'; }
    # Railway's healthcheck Host differs from the public hostname.
    location = /health/ready {
        set $api http://${BACK_HOST}:3001;
        proxy_set_header Host ${PUBLIC_HOST};
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_pass $api/health/ready;
    }
    location / { return 444; }
}
server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name ${PUBLIC_HOST};
    resolver ${DNS_RESOLVER} valid=10s;
    resolver_timeout 3s;
    access_log off;
    server_tokens off;
    client_max_body_size 16k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 15s;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    # TLS terminates at Railway. Only this service is given a public domain.
    # Never trust the client's forwarded address chain.
    proxy_set_header Host ${PUBLIC_HOST};
    proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header Proxy "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 55s;
    proxy_send_timeout 15s;
    proxy_redirect off;
    location = /health/live { default_type application/json; return 200 '{"status":"ok"}'; }
    location = /health/ready {
        set $api http://${BACK_HOST}:3001;
        proxy_pass $api/health/ready;
    }
    location /api/ {
        set $api http://${BACK_HOST}:3001;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;
        proxy_cookie_path /users /api/users;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }
    location / {
        set $frontend http://${FRONT_HOST}:3000;
        proxy_pass $frontend;
    }
}
